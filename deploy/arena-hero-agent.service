[Unit]
Description=Arena Hero resource collection agent
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=arena-hero
Group=arena-hero
WorkingDirectory=/opt/arena-hero-agent
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=ARENA_WORKER_TARGET=12
Environment=ARENA_BEACON_POLICY=retreat
Environment=ARENA_TUNING_GENERATION=0
EnvironmentFile=/etc/arena-hero-agent.env
EnvironmentFile=-/etc/arena-hero-agent/runtime.env
RuntimeDirectory=arena-hero-agent
RuntimeDirectoryMode=0750
ExecStart=/opt/arena-hero-agent/.venv/bin/arena-hero-agent --env-file /etc/arena-hero-agent.env --worker-target ${ARENA_WORKER_TARGET} --beacon-policy ${ARENA_BEACON_POLICY} --heartbeat-file /run/arena-hero-agent/heartbeat.json
Restart=on-failure
RestartPreventExitStatus=2 10 11 12 13 14 130
RestartForceExitStatus=75
RestartSec=15s
WatchdogSec=120s
WatchdogSignal=SIGABRT
NotifyAccess=main
KillSignal=SIGINT
TimeoutStopSec=20s
UMask=0077
MemoryHigh=192M
MemoryMax=256M

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native

StandardOutput=journal
StandardError=journal
SyslogIdentifier=arena-hero-agent

[Install]
WantedBy=multi-user.target
